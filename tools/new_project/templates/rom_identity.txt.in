# ROM identity for @DISPLAY_NAME@ — the single source of truth.
#
# Read by three consumers, so a revision change is made once, here:
#   - the build   (CMake generates snesrecomp_rom_identity.h from this file)
#   - tools/regen.sh
#   - .github/workflows/release.yml
#
# Format is `key = value`, one per line; `#` starts a comment. Values may be
# quoted. Leaving a digest empty means the build cannot verify a ROM it is
# handed — it will say so rather than accept it.

display_name    = @DISPLAY_NAME@
rom_file        = @ROM_FILE@
# Every digest of the bare image (copier header stripped), so the Retro
# catalog can take a submission's identity from this file rather than ask
# the submitter to hash the ROM again. The build verifies on crc32/sha256.
expected_crc32  = @ROM_CRC32@
expected_md5    = @ROM_MD5@
expected_sha1   = @ROM_SHA1@
expected_sha256 = @ROM_SHA256@
rom_size        = @ROM_SIZE@
mapping         = @ROM_MAPPING@
region          = @REGION@
# What a mod package's [[target]] game_id must name to apply to this title
# (snesrecomp/docs/MOD_PACKAGES.md). Stable across revisions on purpose.
game_id         = @GAME_ID@
