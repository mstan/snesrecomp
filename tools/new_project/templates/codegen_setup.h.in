#ifndef CODEGEN_SETUP_H
#define CODEGEN_SETUP_H

/* Identity of the ROM this project was generated from. */
typedef struct GameCodegenIdentity {
    const char *display_name;
    const char *rom_file;
    const char *expected_crc32;
    const char *expected_sha256;
    const char *mapping;
    const char *region;
    const char *cfg_dir;
    const char *out_dir;
    const char *funcs_h;
} GameCodegenIdentity;

extern const GameCodegenIdentity kGameCodegenIdentity;

#endif /* CODEGEN_SETUP_H */
