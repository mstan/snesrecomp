# Build the @DISPLAY_NAME@ SETUP PACK for Linux, Windows, macOS arm64 and macOS
# Intel, and optionally publish the four zips as a GitHub Release.
# MANUAL TRIGGER ONLY.
#
# WHAT THIS BUILDS. Not the game. src/gen/*.c is recompiler output derived
# from ROM bytes: never committed, never in CI, never in a zip. What CI can
# honestly produce is the SETUP HOST -- the same executable built with
# -DSNESRECOMP_SETUP_HOST=ON, i.e. without recompiled code -- packaged with
# the recompiler and this source tree. On the player's machine the launcher
# takes their own ROM, generates, rebuilds, and relaunches into the real game.
# A green run here means four setup packs were produced, nothing more.
#
# THE TOOLCHAIN. Each pack is built with the retcomm-toolchains cmake-clang-v1
# pack, because that is what the player's own rebuild uses: if it cannot build
# this game, CI is where that must fail. By default the pack is embedded in
# the zip (embed_toolchain) so first run downloads nothing; turn it off for a
# lean zip that fetches the pack on demand (Linux pack ~800 MB, Windows
# ~200 MB, macOS ~90 MB).
#
# There is deliberately no push or pull_request trigger. Releases across the
# port set are driven from the studio bulk tool, and a per-repo workflow that
# fires on every push competes with it for minutes and for the meaning of
# "did CI pass". Run this from the Actions tab, or with
#   gh workflow run release.yml
# and pass publish_release from a v* tag to cut a release.

name: Build

on:
  workflow_dispatch:
    inputs:
      publish_release:
        description: 'Publish a GitHub Release (requires a v* tag ref)'
        type: boolean
        default: false
      embed_toolchain:
        description: 'Embed the cmake-clang-v1 pack in each zip (else the launcher downloads it)'
        type: boolean
        default: true
      toolchain_tag:
        description: 'retcomm-toolchains release to build with (empty = latest)'
        type: string
        default: ''
      verify_pins:
        description: 'Fail if the submodules disagree with framework_pins.txt'
        type: boolean
        default: false

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

env:
  EXE_NAME: @PROJECT_NAME@
  ZIP_PREFIX: @ZIP_PREFIX@

jobs:
  preflight:
    name: Preflight
    runs-on: ubuntu-24.04
    outputs:
      version: ${{ steps.meta.outputs.version }}
    steps:
      - uses: actions/checkout@v4
        with:
          submodules: recursive
          fetch-depth: 1

      - name: Record framework pins
        run: |
          set -euo pipefail
          ARGS=()
          if [[ "${{ inputs.verify_pins }}" == "true" ]]; then
            ARGS+=(--check framework_pins.txt)
          fi
          bash snesrecomp/tools/ci/record_pins.sh "${ARGS[@]}"

      - name: Refuse to publish from a non-tag ref
        if: inputs.publish_release && !startsWith(github.ref, 'refs/tags/v')
        run: |
          echo "::error::publish_release was set, but this run is on ${GITHUB_REF}."
          echo "Re-run the workflow selecting a v* tag."
          exit 1

      - name: Resolve release version
        id: meta
        run: |
          set -euo pipefail
          VERSION="$(tr -d '[:space:]' < VERSION)"
          [[ -n "${VERSION}" ]] || { echo "::error::VERSION is empty"; exit 1; }
          if [[ "${{ inputs.publish_release }}" == "true" ]]; then
            # VERSION is the lobby pin compiled into the binary. A tag that
            # disagrees with it ships a release whose peers match on a
            # different string than the one people were told to install.
            if [[ "${GITHUB_REF_NAME#v}" != "${VERSION}" ]]; then
              echo "::error::tag ${GITHUB_REF_NAME} does not match VERSION ${VERSION}."
              echo "The lobby version pin is compiled from VERSION; bump it and retag."
              exit 1
            fi
          fi
          echo "version=${VERSION}" >>"$GITHUB_OUTPUT"
          echo "version ${VERSION}"

  build:
    name: ${{ matrix.artifact }}
    needs: preflight
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: ubuntu-24.04
            artifact: linux-x64
          - os: windows-2022
            artifact: windows-x64
          - os: macos-15
            artifact: macos-arm64
          - os: macos-15-intel
            artifact: macos-x64
    defaults:
      run:
        shell: bash
    env:
      RELEASE_VERSION: ${{ needs.preflight.outputs.version }}

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          submodules: recursive
          fetch-depth: 1

      - name: Record framework pins
        run: bash snesrecomp/tools/ci/record_pins.sh

      # A setup host is defined by what it lacks. The checkout must carry no
      # generated C; if it ever does, that is committed ROM-derived output and
      # the build must stop here rather than package it.
      - name: Assert no generated C in the tree
        run: |
          set -euo pipefail
          if compgen -G 'src/gen/*.c' >/dev/null || [[ -f recomp/funcs.h ]]; then
            echo "::error::src/gen/*.c or recomp/funcs.h is present in the checkout."
            exit 1
          fi
          echo "src/gen is empty — building the setup host."

      - name: Cache toolchain pack
        uses: actions/cache@v4
        with:
          path: .cache/toolchain-pack
          key: cmake-clang-v1-${{ matrix.artifact }}-${{ inputs.toolchain_tag || 'latest' }}

      - name: Fetch toolchain pack
        run: |
          set -euo pipefail
          ARGS=(--artifact "${{ matrix.artifact }}")
          if [[ -n "${{ inputs.toolchain_tag }}" ]]; then
            ARGS+=(--tag "${{ inputs.toolchain_tag }}")
          fi
          bash snesrecomp/tools/ci/fetch_toolchain.sh "${ARGS[@]}"

      # The macOS pack is cmake + ninja + python; SDL3 comes from
      # runner.cmake's pinned source fallback. Prefetch the tarball with curl
      # (HTTP/1.1) and cache it, so configure does not download.
      - name: Cache SDL3 source (macOS)
        if: runner.os == 'macOS'
        uses: actions/cache@v4
        with:
          path: .cache/sdl3-src
          key: sdl3-src-3.4.10

      - name: Prefetch SDL3 source (macOS)
        if: runner.os == 'macOS'
        run: bash snesrecomp/tools/ci/prefetch_sdl3.sh --out-dir .cache/sdl3-src

      - name: Configure and build the setup host
        run: |
          set -euo pipefail
          # The pack's env.sh is its own statement of how to use it (PATH,
          # CC/CXX, sysroot, SDL3_DIR). Source it rather than restate it.
          # shellcheck disable=SC1091
          source "${TOOLCHAIN_DIR}/env.sh"
          echo "cmake: $(command -v cmake) ($(cmake --version | head -n1))"
          echo "cc:    ${CC:-$(command -v cc)}"
          EXTRA=()
          if [[ -n "${SNESRECOMP_SDL3_SOURCE_DIR:-}" ]]; then
            EXTRA+=("-DSNESRECOMP_SDL3_SOURCE_DIR=${SNESRECOMP_SDL3_SOURCE_DIR}")
          fi
          if [[ "${{ runner.os }}" == "macOS" ]]; then
            EXTRA+=("-DCMAKE_OSX_DEPLOYMENT_TARGET=11.0")
          fi
          JOBS="$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)"
          cmake -S . -B build-ci -G Ninja \
            -DCMAKE_BUILD_TYPE=Release \
            -DSNESRECOMP_SETUP_HOST=ON \
            -DSNESRECOMP_ENABLE_TRACE=OFF \
            -DSNESRECOMP_BUILD_VERSION="${RELEASE_VERSION}" \
            "${EXTRA[@]+"${EXTRA[@]}"}"
          cmake --build build-ci -j"${JOBS}" --target "${EXE_NAME}"

      - name: Package setup pack
        run: |
          set -euo pipefail
          # The packager inspects the executable's imports (objdump) and zips
          # the stage; Git Bash on Windows has neither tool, the pack does.
          # shellcheck disable=SC1091
          source "${TOOLCHAIN_DIR}/env.sh"
          ARGS=()
          if [[ "${{ inputs.embed_toolchain }}" != "false" ]]; then
            ARGS+=(--embed-toolchain)
          fi
          bash scripts/package_release.sh build-ci "${{ matrix.artifact }}" "${ARGS[@]+"${ARGS[@]}"}"
          ls -la dist/

      - uses: actions/upload-artifact@v4
        with:
          name: ${{ env.ZIP_PREFIX }}-${{ matrix.artifact }}
          path: dist/${{ env.ZIP_PREFIX }}-*-${{ matrix.artifact }}.zip
          if-no-files-found: error
          retention-days: 7
          compression-level: 0

  release:
    name: GitHub Release
    needs: [preflight, build]
    if: inputs.publish_release
    runs-on: ubuntu-24.04
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
        with:
          submodules: recursive
          fetch-depth: 1

      - uses: actions/download-artifact@v4
        with:
          path: artifacts

      - name: Collect zips
        run: |
          set -euo pipefail
          mkdir -p dist
          find artifacts -type f -name "${ZIP_PREFIX}-*.zip" -exec cp -v {} dist/ \;
          # Four platforms in, four zips out. A release that silently carries
          # three is the failure this counts for.
          count="$(find dist -name "${ZIP_PREFIX}-*.zip" | wc -l | tr -d ' ')"
          if [[ "${count}" -ne 4 ]]; then
            echo "::error::expected 4 platform zips, found ${count}"
            ls -la dist
            exit 1
          fi
          ( cd dist && sha256sum "${ZIP_PREFIX}"-*.zip > SHA256SUMS )
          cat dist/SHA256SUMS

      - name: Release notes
        run: |
          set -euo pipefail
          {
            echo "@DISPLAY_NAME@ ${GITHUB_REF_NAME} — setup packs"
            echo
            echo "These packs do not contain the game. Each holds a setup program, the"
            echo "recompiler and the source; on first run it takes your own copy of"
            echo "@ROM_FILE@ (SHA-256 @ROM_SHA256@), recompiles it locally, and builds"
            echo "the playable game. No ROM data is included or downloaded."
            echo
            if [[ "${{ inputs.embed_toolchain }}" != "false" ]]; then
              echo "The portable build tools (cmake-clang-v1) are embedded in every pack."
            else
              echo "The portable build tools (cmake-clang-v1) are downloaded on first run."
            fi
            echo
            echo '### Framework revisions'
            echo
            echo '```'
            bash snesrecomp/tools/ci/record_pins.sh
            echo '```'
          } > notes.md
          cat notes.md

      - name: Publish release
        uses: softprops/action-gh-release@v2
        with:
          name: "@DISPLAY_NAME@ ${{ github.ref_name }}"
          body_path: notes.md
          files: |
            dist/${{ env.ZIP_PREFIX }}-*.zip
            dist/SHA256SUMS
          fail_on_unmatched_files: true
